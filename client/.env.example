# Google Maps API Key (required)
# Get yours at: https://console.cloud.google.com/
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Legacy alias kept for backwards compatibility (same value as above)
REACT_APP_Maps_API_KEY=your_google_maps_api_key_here

# Kakao API Keys (optional)
# Get yours at: https://developers.kakao.com/
REACT_APP_KAKAO_JS_KEY=your_kakao_javascript_key_here
REACT_APP_KAKAO_REST_KEY=your_kakao_rest_api_key_here
