# Copy this file to .env and fill in the actual values.
# DO NOT commit the .env file to version control.

# Google Maps API Key
# Obtain from: https://console.cloud.google.com/ > APIs & Services > Credentials
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Legacy alias (same key) — kept for backward compatibility
REACT_APP_Maps_API_KEY=your_google_maps_api_key_here

# Kakao API Keys
# Obtain from: https://developers.kakao.com/ > My Applications > App Keys
REACT_APP_KAKAO_JS_KEY=your_kakao_javascript_key_here
REACT_APP_KAKAO_REST_KEY=your_kakao_rest_api_key_here
